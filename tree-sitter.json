{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "picat",
      "camelcase": "Picat",
      "title": "Picat",
      "scope": "source.picat",
      "file-types": [
        "pi"
      ],
      "injection-regex": "^(pi|picat)$",
      "class-name": "TreeSitterPicat",
      "highlights": [
        "queries/highlights.scm"
      ],
      "locals": [
        "queries/locals.scm"
      ],
      "tags": [
        "queries/tags.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Picat",
    "authors": [
      {
        "name": "DLR-FT",
        "email": "tim.schubert@dlr.de",
        "url": "https://dlr.de/ft"
      }
    ],
    "links": {
      "repository": "https://github.com/DLR-FT/tree-sitter-picat"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
