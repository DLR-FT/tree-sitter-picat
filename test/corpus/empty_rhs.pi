/*
 * Prints
 *  Welcome to PICAT's world!
 */

main(Args) =>
	print(" Welcome to PICAT’s world! \n"),
	foreach (Arg in Args)
		printf("%s\n", Arg),
		% printf("%s\r\n", Arg),
	end.

